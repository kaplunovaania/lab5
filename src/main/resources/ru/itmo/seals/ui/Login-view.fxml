<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="15" xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1" fx:controller="ru.itmo.seals.ui.LoginController"
      stylesheets="@styles.css" styleClass="login-pane">

    <padding>
        <Insets top="30" right="30" bottom="30" left="30"/>
    </padding>

    <Label text="Task Manager" styleClass="login-title"/>

    <TextField fx:id="loginField" promptText="Login" maxWidth="250"/>
    <PasswordField fx:id="passwordField" promptText="Password" maxWidth="250"/>

    <HBox spacing="10" alignment="CENTER">
        <Button text="Login" onAction="#handleLogin" styleClass="btn-primary"/>
        <Button text="Register" onAction="#handleRegister" styleClass="btn-primary"/>
    </HBox>

    <Label fx:id="messageLabel" styleClass="error-label" textFill="#D81B60"/>

</VBox>
