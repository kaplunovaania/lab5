<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="ru.itmo.seals.ui.MasterController"
            prefWidth="1100" prefHeight="650">

    <!-- ВЕРХНЯЯ ПАНЕЛЬ С КНОПКАМИ -->
    <top>
        <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 10; -fx-background-color: #f0f0f0;">
            <Button text="🔄 Refresh" onAction="#handleRefresh" style="-fx-font-weight: bold;"/>
            <Button text="➕ Add Task" onAction="#handleAddTask"/>
            <Button text="💾 Save" onAction="#handleSave"/>
            <Button text="📂 Load" onAction="#handleLoad"/>
            <Label fx:id="statusLabel" HBox.hgrow="ALWAYS"
                   style="-fx-text-fill: green; -fx-font-weight: bold;"/>
        </HBox>
    </top>

    <!-- ЛЕВАЯ ЧАСТЬ: СПИСОК ЗАДАЧ (MASTER) -->
    <left>
        <VBox prefWidth="400">
            <Label text="Tasks" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-padding: 10;">
                <font><Font name="System Bold" size="18"/></font>
            </Label>
            <TableView fx:id="taskTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="idColumn" text="ID" prefWidth="70"/>
                    <TableColumn fx:id="textColumn" text="Task" prefWidth="200"/>
                    <TableColumn fx:id="statusColumn" text="Status" prefWidth="100"/>
                </columns>
            </TableView>
        </VBox>
    </left>

    <!-- ПРАВАЯ ЧАСТЬ: ДЕТАЛИ ЗАДАЧИ (DETAIL) -->
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER">
            <VBox spacing="15" style="-fx-padding: 20;">
                <Label text="Task Details" style="-fx-font-size: 22px; -fx-font-weight: bold;">
                    <font><Font name="System Bold" size="22"/></font>
                </Label>

                <GridPane hgap="15" vgap="12">
                    <Label text="ID:" GridPane.rowIndex="0" GridPane.columnIndex="0"
                           style="-fx-font-weight: bold;"/>
                    <Label fx:id="detailId" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                    <Label text="Text:" GridPane.rowIndex="1" GridPane.columnIndex="0"
                           style="-fx-font-weight: bold;"/>
                    <Label fx:id="detailText" GridPane.rowIndex="1" GridPane.columnIndex="1"
                           wrapText="true" maxWidth="400"/>

                    <Label text="Status:" GridPane.rowIndex="2" GridPane.columnIndex="0"
                           style="-fx-font-weight: bold;"/>
                    <Label fx:id="detailStatus" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                    <Label text="Priority:" GridPane.rowIndex="3" GridPane.columnIndex="0"
                           style="-fx-font-weight: bold;"/>
                    <Label fx:id="detailPriority" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                    <Label text="Deadline:" GridPane.rowIndex="4" GridPane.columnIndex="0"
                           style="-fx-font-weight: bold;"/>
                    <Label fx:id="detailDeadline" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                    <Label text="Assignee:" GridPane.rowIndex="5" GridPane.columnIndex="0"
                           style="-fx-font-weight: bold;"/>
                    <Label fx:id="detailAssignee" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

                    <Label text="Owner:" GridPane.rowIndex="6" GridPane.columnIndex="0"
                           style="-fx-font-weight: bold;"/>
                    <Label fx:id="detailOwner" GridPane.rowIndex="6" GridPane.columnIndex="1"/>
                </GridPane>

                <Separator/>

                <Label text="Checklist" style="-fx-font-size: 18px; -fx-font-weight: bold;">
                    <font><Font name="System Bold" size="18"/></font>
                </Label>
                <ListView fx:id="checklistView" prefHeight="200"/>

                <HBox spacing="10">
                    <Button text="✓ Toggle" onAction="#handleToggleChecklist"/>
                    <Button text="➕ Add Item" onAction="#handleAddChecklist"/>
                    <Button text="✏️ Edit" onAction="#handleEditTask"/>
                    <Button text="🗑️ Delete" onAction="#handleDeleteTask"
                            style="-fx-text-fill: white; -fx-background-color: #d9534f;"/>
                </HBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
