<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="700" prefWidth="1200" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ru.itmo.seals.ui.MasterController">

    <top>
        <VBox>
            <HBox alignment="CENTER_LEFT" styleClass="top-bar" spacing="10">
                <Button onAction="#handleRefresh" styleClass="btn-primary" text="Refresh" />
                <Button onAction="#handleAddTask" styleClass="btn-primary" text="Add Task" />
                <Button onAction="#handleSave" styleClass="btn-primary" text="Save" />
                <Button onAction="#handleLoad" styleClass="btn-primary" text="Load" />

                <TextField fx:id="searchField" onKeyTyped="#handleSearch" promptText="Search task..."
                           styleClass="search-field" HBox.hgrow="ALWAYS" prefWidth="200">
                    <HBox.margin>
                        <Insets left="10" right="10" />
                    </HBox.margin>
                </TextField>

                <Button onAction="#toggleFilterPanel" text="Фильтры" styleClass="btn-primary"/>

                <Label fx:id="statusLabel" styleClass="status-label" HBox.hgrow="ALWAYS" />

                <Button mnemonicParsing="false" onAction="#handleLogin" styleClass="btn-primary" text="Login"/>
                <Button mnemonicParsing="false" onAction="#handleRegister" styleClass="btn-primary" text="Register"/>
                <Label fx:id="currentUserLabel" text="Not logged in" styleClass="status-label"/>
                <Button mnemonicParsing="false" onAction="#handleLogout" styleClass="btn-danger" text="Logout" />
            </HBox>

            <HBox fx:id="filterPanel" visible="false" managed="false" spacing="15"
                  style="-fx-padding: 15; -fx-background-color: #f8f8f8; -fx-border-color: #ddd; -fx-border-width: 0 0 1 0;">

                <VBox spacing="5">
                    <Label text="Приоритет:" style="-fx-font-weight: bold;"/>
                    <ChoiceBox fx:id="filterPriority" prefWidth="120"/>
                </VBox>

                <VBox spacing="5">
                    <Label text="Статус:" style="-fx-font-weight: bold;"/>
                    <ChoiceBox fx:id="filterStatus" prefWidth="120"/>
                </VBox>

                <VBox spacing="5">
                    <Label text="Дедлайн:" style="-fx-font-weight: bold;"/>
                    <HBox spacing="5">
                        <DatePicker fx:id="filterDeadlineFrom" prefWidth="110" promptText="от"/>
                        <Label text="до" alignment="CENTER" prefWidth="25"/>
                        <DatePicker fx:id="filterDeadlineTo" prefWidth="110" promptText="до"/>
                    </HBox>
                </VBox>

                <VBox spacing="5">
                    <Label text="Назначен:" style="-fx-font-weight: bold;"/>
                    <TextField fx:id="filterAssignee" prefWidth="120" promptText="Username"/>
                </VBox>

                <VBox spacing="5">
                    <Label text=" "/>
                    <HBox spacing="5">
                        <Button text="Применить" onAction="#applyFilters"
                                style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-padding: 5 15;"/>
                        <Button text="Сбросить" onAction="#clearFilters"
                                style="-fx-background-color: #f44336; -fx-text-fill: white; -fx-padding: 5 15;"/>
                    </HBox>
                </VBox>

            </HBox>
        </VBox>
    </top>

    <left>
        <VBox prefWidth="450" styleClass="side-panel">
            <Label styleClass="panel-title" text="Tasks">
                <VBox.margin>
                    <Insets bottom="10" />
                </VBox.margin>
            </Label>

            <ProgressBar fx:id="progressBar" managed="false" prefWidth="430" visible="false">
                <VBox.margin>
                    <Insets bottom="10" />
                </VBox.margin>
            </ProgressBar>
            <Label fx:id="progressLabel" managed="false" styleClass="progress-label" visible="false" />

            <TableView fx:id="taskTable" prefHeight="548.0" prefWidth="479.0" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="idColumn" prefWidth="50" text="ID" />
                    <TableColumn fx:id="textColumn" prefWidth="150" text="Task" />
                    <TableColumn fx:id="priorityColumn" prefWidth="75" text="Priority" />
                    <TableColumn fx:id="statusColumn" prefWidth="85" text="Status" />
                    <TableColumn fx:id="deadlineColumn" prefWidth="85" text="Deadline" />
                    <TableColumn fx:id="assigneeColumn" prefWidth="80" text="Assignee" />
                    <TableColumn fx:id="ownerColumn" prefWidth="70" text="Owner" />
                </columns>
            </TableView>
        </VBox>
    </left>
    <right>
        <VBox fx:id="statisticsPanel" prefHeight="602.0" prefWidth="249.0" spacing="10" style="-fx-padding: 15; -fx-background-color: #f5f5f5; -fx-border-color: #ddd; -fx-border-radius: 5;">

            <Label alignment="CENTER" maxWidth="Infinity" style="-fx-font-size: 16px; -fx-font-weight: bold;" text="СТАТИСТИКА" />

            <Separator />

            <HBox spacing="10">
                <Label style="-fx-font-weight: bold;" text="Всего:" />
                <Label fx:id="statTotal" style="-fx-font-weight: bold;" text="0" />
            </HBox>

            <Separator />

            <Label style="-fx-font-weight: bold;" text="По статусам:" />
            <VBox spacing="5">
                <HBox spacing="10">
                    <Label text="Новые:" />
                    <Label fx:id="statNew" text="0" />
                </HBox>
                <HBox spacing="10">
                    <Label text="В работе:" />
                    <Label fx:id="statInProgress" text="0" />
                </HBox>
                <HBox spacing="10">
                    <Label text="Выполнено:" />
                    <Label fx:id="statDone" text="0" />
                </HBox>
            </VBox>

            <Separator />

            <Label style="-fx-font-weight: bold;" text="По приоритетам:" />
            <VBox spacing="5">
                <HBox spacing="10">
                    <Label text="Высокий:" />
                    <Label fx:id="statHigh" style="-fx-text-fill: red;" text="0" />
                </HBox>
                <HBox spacing="10">
                    <Label text="Средний:" />
                    <Label fx:id="statMedium" style="-fx-text-fill: orange;" text="0" />
                </HBox>
                <HBox spacing="10">
                    <Label text="Низкий:" />
                    <Label fx:id="statLow" style="-fx-text-fill: green;" text="0" />
                </HBox>
            </VBox>

            <Separator />

            <HBox spacing="10">
                <Label text="Просрочено:" />
                <Label fx:id="statOverdue" style="-fx-text-fill: red; -fx-font-weight: bold;" text="0" />
            </HBox>

        </VBox>
    </right>
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefHeight="602.0" prefWidth="467.0">
            <VBox prefHeight="622.0" prefWidth="297.0" spacing="15" styleClass="detail-panel">
                <padding>
                    <Insets bottom="20" left="20" right="20" top="20" />
                </padding>

                <Label styleClass="detail-title" text="Task Details" />

                <GridPane hgap="15" styleClass="detail-grid" vgap="10">
                    <Label styleClass="field-label" text="ID:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                    <Label fx:id="detailId" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                    <Label styleClass="field-label" text="Text:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                    <Label fx:id="detailText" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                    <Label styleClass="field-label" text="Status:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                    <Label fx:id="detailStatus" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                    <Label styleClass="field-label" text="Priority:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                    <Label fx:id="detailPriority" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                    <Label styleClass="field-label" text="Deadline:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                    <Label fx:id="detailDeadline" GridPane.columnIndex="1" GridPane.rowIndex="4" />

                    <Label styleClass="field-label" text="Assignee:" GridPane.columnIndex="0" GridPane.rowIndex="5" />
                    <Label fx:id="detailAssignee" GridPane.columnIndex="1" GridPane.rowIndex="5" />

                    <Label styleClass="field-label" text="Owner:" GridPane.columnIndex="0" GridPane.rowIndex="6" />
                    <Label fx:id="detailOwner" GridPane.columnIndex="1" GridPane.rowIndex="6" />

                    <Label styleClass="field-label" text="Created:" GridPane.columnIndex="0" GridPane.rowIndex="7" />
                    <Label fx:id="detailCreated" GridPane.columnIndex="1" GridPane.rowIndex="7" />

                    <Label styleClass="field-label" text="Updated:" GridPane.columnIndex="0" GridPane.rowIndex="8" />
                    <Label fx:id="detailUpdated" GridPane.columnIndex="1" GridPane.rowIndex="8" />
               <columnConstraints>
                  <ColumnConstraints />
                  <ColumnConstraints />
               </columnConstraints>
               <rowConstraints>
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
               </rowConstraints>
                </GridPane>

                <Separator />

                <VBox spacing="10">
                    <Label styleClass="section-title" text="Checklist" />
                    <ListView fx:id="checklistView" prefHeight="180" />

                    <HBox spacing="10">
                        <Button onAction="#handleToggleChecklist" text="Toggle" />
                        <Button onAction="#handleAddChecklist" text="Add Item" />
                        <Button fx:id="editButton" onAction="#handleEditTask" text="Edit" />
                        <Button fx:id="deleteButton" onAction="#handleDeleteTask" styleClass="btn-danger" text="Delete Task" />
                    </HBox>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <HBox alignment="CENTER_LEFT" styleClass="status-bar">
            <Label fx:id="statusBarText" text="Ready" />
            <Label styleClass="separator" text="|" />
            <Label text="Tasks:" />
            <Label fx:id="taskCount" styleClass="count-label" text="0" />
            <Label styleClass="separator" text="|" />
            <Label fx:id="lastRefresh" text="-" />
            <Label HBox.hgrow="ALWAYS" />
            <Label styleClass="version-label" text="Task Manager v1.0" />
        </HBox>
    </bottom>
</BorderPane>
